# 应用配置
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# DashScope 配置
# 在 https://bailian.console.aliyun.com/ 创建 API Key
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# 百炼重排模型，用于 RAG 检索结果二次精排（gte-rerank-v2 / qwen3-rerank）
DASHSCOPE_RERANK_MODEL=gte-rerank-v2

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
# 重排前从向量库召回的候选文档数（recall -> rerank -> top_k）
RAG_RECALL_K=20
RAG_MODEL=qwen-max

# RAG 上下文自动压缩配置
RAG_CONTEXT_WINDOW=30720
RAG_CONTEXT_TRIGGER_FRACTION=0.7
RAG_CONTEXT_KEEP_MESSAGES=20

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio、sse（腾讯云等 /sse/ 端点）、streamable-http（本地 FastMCP）
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# Prometheus（告警查询工具等）
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0
